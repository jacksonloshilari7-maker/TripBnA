rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isTripMember(tripData) {
      return isAuthenticated() && (
        request.auth.uid == tripData.organizerId ||
        (tripData.memberIds != null && request.auth.uid in tripData.memberIds)
      );
    }

    // 1. Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      // Users can create and update their own document, but CANNOT escalate to admin role unless already admin
      allow create: if isOwner(userId) && (!('role' in request.resource.data) || request.resource.data.role != 'admin' || isAdmin());
      allow update: if (isOwner(userId) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']) || resource.data.role == request.resource.data.role || isAdmin())) || isAdmin();
      allow delete: if isAdmin();
    }

    // Admins registry
    match /admins/{adminId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 2. Trips collection
    match /trips/{tripId} {
      // Trips can be searched and discovered publicly on Trip Finder and Tripline
      allow read: if true;
      
      // Authenticated users can create trips where they are the designated organizer
      allow create: if isAuthenticated() 
        && request.resource.data.organizerId == request.auth.uid
        && (request.resource.data.memberIds == null || request.auth.uid in request.resource.data.memberIds);
      
      // Organizers can update their trips, and modify memberIds when accepting members
      allow update: if isAuthenticated() && (
        resource.data.organizerId == request.auth.uid ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds']) && resource.data.organizerId == request.auth.uid)
      );
      
      // Only the trip organizer can delete their trip
      allow delete: if isAuthenticated() && resource.data.organizerId == request.auth.uid;

      // 3. Trip Itinerary subcollections (itinerary and itineraryData)
      match /itineraryData/{docId} {
        allow read: if isAuthenticated() && isTripMember(get(/databases/$(database)/documents/trips/$(tripId)).data);
        allow write: if isAuthenticated() && get(/databases/$(database)/documents/trips/$(tripId)).data.organizerId == request.auth.uid;
      }
      match /itinerary/{dayId} {
        allow read: if isAuthenticated() && isTripMember(get(/databases/$(database)/documents/trips/$(tripId)).data);
        allow write: if isAuthenticated() && get(/databases/$(database)/documents/trips/$(tripId)).data.organizerId == request.auth.uid;
      }

      // 4. Private Group Messages subcollection (accessible only to organizer and accepted members)
      match /messages/{messageId} {
        allow read: if isAuthenticated() && isTripMember(get(/databases/$(database)/documents/trips/$(tripId)).data);
        allow create: if isAuthenticated() 
          && isTripMember(get(/databases/$(database)/documents/trips/$(tripId)).data)
          && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if isAuthenticated() && resource.data.senderId == request.auth.uid;
      }
    }

    // 5. Trip Join Requests (Trip Finder -> Trip Organiser)
    match /tripRequests/{requestId} {
      allow read: if isAuthenticated() && (
        resource.data.organizerId == request.auth.uid ||
        resource.data.requesterId == request.auth.uid
      );
      allow create: if isAuthenticated() && request.resource.data.requesterId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.organizerId == request.auth.uid ||
        resource.data.requesterId == request.auth.uid
      );
      allow delete: if isAuthenticated() && (
        resource.data.organizerId == request.auth.uid ||
        resource.data.requesterId == request.auth.uid
      );
    }

    // 6. Incoming Unmatched Requests
    match /incomingRequests/{incomingId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.requesterId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.requesterId == request.auth.uid;
    }

    // 7. Tripline Community Posts
    match /posts/{postId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.authorId == request.auth.uid;
    }

    // 8. User Bookings & E-Tickets
    match /bookings/{bookingId} {
      // Customers see their own bookings; Providers see bookings assigned to them; Admin sees all bookings
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.providerId == request.auth.uid ||
        isAdmin()
      );
      // Customers can create their bookings
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      // Admin can update any booking status; Provider or Customer can update their respective bookings
      allow update: if isAuthenticated() && (
        isAdmin() ||
        resource.data.providerId == request.auth.uid ||
        resource.data.userId == request.auth.uid
      );
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'jacksonloshilari7@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isServiceProvider(serviceData) {
      return isAuthenticated() && (
        request.auth.uid == serviceData.providerId ||
        request.auth.uid == serviceData.ownerId
      );
    }

    // 9. Accommodations, Food & Services Catalog (with pictures & playable videos)
    match /services/{serviceId} {
      // Visible to public/regular users only if approved by admin; providers can see their own; admins see all
      allow read: if resource.data.status == 'Approved' || isServiceProvider(resource.data) || isAdmin();

      // Providers can create their own accommodation or food services, but status MUST be 'Pending' (unless Admin)
      allow create: if isAuthenticated() && (
        isAdmin() ||
        (
          (request.resource.data.providerId == request.auth.uid || request.resource.data.ownerId == request.auth.uid) &&
          request.resource.data.status == 'Pending'
        )
      );

      // Admin can approve, reject, publish, or suspend services.
      // Providers can update their own services, BUT cannot set status to 'Approved', 'Rejected', or 'Suspended'.
      // Provider updates automatically set or keep status as 'Pending' or 'Pending Review'.
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (
          isServiceProvider(resource.data) &&
          (request.resource.data.status == 'Pending' || request.resource.data.status == 'Pending Review') &&
          (!('providerId' in request.resource.data) || request.resource.data.providerId == resource.data.providerId)
        )
      );

      // Only provider owner or Admin can delete
      allow delete: if isAuthenticated() && (isServiceProvider(resource.data) || isAdmin());
    }
  }
}


