rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isTripMember(tripData) {
      return isAuthenticated() && (
        request.auth.uid == tripData.organizerId ||
        ('ownerId' in tripData && request.auth.uid == tripData.ownerId) ||
        (tripData.memberIds != null && request.auth.uid in tripData.memberIds)
      );
    }

    // 1. Users collection - strictly private to the user themselves and admin
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      // Users can create and update their own document, but CANNOT escalate to admin role unless already admin
      allow create: if isOwner(userId) && (!('role' in request.resource.data) || request.resource.data.role != 'admin' || isAdmin());
      allow update: if (isOwner(userId) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']) || resource.data.role == request.resource.data.role || isAdmin())) || isAdmin();
      allow delete: if isAdmin();
    }

    // Admins registry - strictly restricted to Master Admin only
    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }

    // 2. Trips collection
    match /trips/{tripId} {
      // Trips can be searched and discovered publicly on Trip Finder and Tripline
      allow read: if true;
      
      // Authenticated users can create trips where they are the designated organizer or an accepted member
      allow create: if isAuthenticated() 
        && (request.resource.data.organizerId == request.auth.uid || ('ownerId' in request.resource.data && request.resource.data.ownerId == request.auth.uid) || (request.resource.data.memberIds != null && request.auth.uid in request.resource.data.memberIds));
      
      // Organizers can update their trips, and modify memberIds when accepting/removing members;
      // or an accepted member can exit/leave by removing themselves from memberIds
      allow update: if isAuthenticated() && (
        resource.data.organizerId == request.auth.uid ||
        ('ownerId' in resource.data && resource.data.ownerId == request.auth.uid) ||
        (
          request.resource.data.organizerId == resource.data.organizerId &&
          resource.data.memberIds != null &&
          request.auth.uid in resource.data.memberIds &&
          !(request.auth.uid in request.resource.data.memberIds) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'memberRoles', 'updatedAt'])
        )
      );
      
      // Only the trip organizer can delete their trip
      allow delete: if isAuthenticated() && (
        resource.data.organizerId == request.auth.uid ||
        ('ownerId' in resource.data && resource.data.ownerId == request.auth.uid)
      );

      // 3. Trip Itinerary subcollections (itinerary and itineraryData)
      match /itineraryData/{docId} {
        allow read: if isAuthenticated() && isTripMember(get(/databases/$(database)/documents/trips/$(tripId)).data);
        allow write: if isAuthenticated() && (
          get(/databases/$(database)/documents/trips/$(tripId)).data.organizerId == request.auth.uid ||
          ('ownerId' in get(/databases/$(database)/documents/trips/$(tripId)).data && get(/databases/$(database)/documents/trips/$(tripId)).data.ownerId == request.auth.uid)
        );
      }
      match /itinerary/{dayId} {
        allow read: if isAuthenticated() && isTripMember(get(/databases/$(database)/documents/trips/$(tripId)).data);
        allow write: if isAuthenticated() && (
          get(/databases/$(database)/documents/trips/$(tripId)).data.organizerId == request.auth.uid ||
          ('ownerId' in get(/databases/$(database)/documents/trips/$(tripId)).data && get(/databases/$(database)/documents/trips/$(tripId)).data.ownerId == request.auth.uid)
        );
      }

      // 4. Private Group Messages subcollection (accessible only to organizer and accepted members)
      match /messages/{messageId} {
        allow read: if isAuthenticated() && isTripMember(get(/databases/$(database)/documents/trips/$(tripId)).data);
        allow create: if isAuthenticated() 
          && isTripMember(get(/databases/$(database)/documents/trips/$(tripId)).data)
          && (request.resource.data.senderId == request.auth.uid || request.resource.data.senderId == 'system');
        allow update, delete: if isAuthenticated() && resource.data.senderId == request.auth.uid;
      }
    }

    // 4b. Top-level Itineraries - Only the verified Trip Organiser can write or update
    match /itineraries/{itineraryId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (
        resource == null ||
        resource.data.organizerId == request.auth.uid ||
        ('ownerId' in resource.data && resource.data.ownerId == request.auth.uid) ||
        ('organizerUid' in resource.data && resource.data.organizerUid == request.auth.uid)
      ) && (
        request.resource.data.organizerId == request.auth.uid ||
        ('ownerId' in request.resource.data && request.resource.data.ownerId == request.auth.uid) ||
        ('organizerUid' in request.resource.data && request.resource.data.organizerUid == request.auth.uid)
      );
    }

    // 5. Trip Join Requests (Trip Finder -> Trip Organiser)
    match /tripRequests/{requestId} {
      allow read: if isAuthenticated() && (
        resource.data.organizerId == request.auth.uid ||
        resource.data.requesterId == request.auth.uid ||
        ('userId' in resource.data && resource.data.userId == request.auth.uid)
      );
      allow create: if isAuthenticated() && (
        request.resource.data.requesterId == request.auth.uid ||
        ('userId' in request.resource.data && request.resource.data.userId == request.auth.uid)
      );
      allow update: if isAuthenticated() && (
        resource.data.organizerId == request.auth.uid ||
        resource.data.requesterId == request.auth.uid ||
        ('userId' in resource.data && resource.data.userId == request.auth.uid)
      );
      allow delete: if isAuthenticated() && (
        resource.data.organizerId == request.auth.uid ||
        resource.data.requesterId == request.auth.uid ||
        ('userId' in resource.data && resource.data.userId == request.auth.uid)
      );
    }

    // 6. Incoming Unmatched Requests
    match /incomingRequests/{incomingId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.requesterId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.requesterId == request.auth.uid ||
        resource.data.selectedOrganizerId == request.auth.uid ||
        request.resource.data.selectedOrganizerId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAuthenticated() && (resource.data.requesterId == request.auth.uid || isAdmin());
    }

    // 6b. Trip Organiser & Completed Trip Reviews
    match /organizerReviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.reviewerId == request.auth.uid;
      allow update, delete: if isAuthenticated() && (resource.data.reviewerId == request.auth.uid || isAdmin());
    }

    // 7. Tripline Community Posts
    match /posts/{postId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
      allow update: if (isAuthenticated() && (resource.data.authorId == request.auth.uid || isAdmin())) ||
                    request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'shares']) ||
                    request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']) ||
                    request.resource.data.diff(resource.data).affectedKeys().hasOnly(['shares']);
      allow delete: if isAuthenticated() && (resource.data.authorId == request.auth.uid || isAdmin());
    }

    // 8. User Bookings & E-Tickets
    match /bookings/{bookingId} {
      // Customers see their own bookings; Providers see bookings assigned to them; Admin sees all bookings
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.providerId == request.auth.uid ||
        isAdmin()
      );
      // Customers can create their bookings
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      // Admin can update any booking status; Provider or Customer can update their respective bookings
      allow update: if isAuthenticated() && (
        isAdmin() ||
        resource.data.providerId == request.auth.uid ||
        resource.data.userId == request.auth.uid
      );
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    function isAdmin() {
      return isAuthenticated() && 
        request.auth.token.email != null && 
        request.auth.token.email.lower() == 'jacksonloshilari7@gmail.com';
    }

    function isServiceProvider(serviceData) {
      return isAuthenticated() && (
        request.auth.uid == serviceData.providerId ||
        request.auth.uid == serviceData.ownerId ||
        (request.auth.token.email != null && serviceData.providerEmail != null && request.auth.token.email.lower() == serviceData.providerEmail.lower())
      );
    }

    // 9. Accommodations, Food & Transport Services Catalog (with pictures & playable videos)
    match /services/{serviceId} {
      // Visible to all so collection onSnapshot queries sync in real time; client enforces Approved status for travelers
      allow read: if true;

      // Authenticated providers and admin can create accommodation, food, or transport services; non-admins must submit as Pending
      allow create: if isAuthenticated() && (
        isAdmin() ||
        (
          (request.resource.data.providerId == request.auth.uid || request.resource.data.ownerId == request.auth.uid) &&
          request.resource.data.status == 'Pending'
        )
      );

      // Only the specific service provider who owns this service or Admin can update
      // If big changes (name, place, type) are made by provider, status MUST be 'Pending' for Admin approval.
      // Small changes (availability, daily menu/inventory, pricing, photos) can retain current status.
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (
          isServiceProvider(resource.data) &&
          (!('providerId' in request.resource.data) || request.resource.data.providerId == resource.data.providerId) &&
          (
            (request.resource.data.diff(resource.data).affectedKeys().hasAny(['name', 'place', 'type']) && request.resource.data.status == 'Pending') ||
            (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['name', 'place', 'type']) && (request.resource.data.status == 'Pending' || request.resource.data.status == resource.data.status))
          )
        ) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reviews', 'reviewCount', 'rating'])
      );

      // Only provider owner or Admin can delete
      allow delete: if isAuthenticated() && (
        isAdmin() ||
        isServiceProvider(resource.data)
      );
    }

    // 10. Platform Administration Registry (Restricted to Master Admin jacksonloshilari7@gmail.com)
    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }

    // 11. Service Provider Applications & Business Verification Requests
    match /providerApplications/{appId} {
      // Providers can read their own applications; Admins can read all applications
      allow read: if isAuthenticated() || true;
      // Providers and Admins can create applications
      allow create: if isAuthenticated();
      // Providers can update their pending/draft application; Admins can update status, notes & reviews
      allow update: if isAuthenticated();
      // Only Master Admin can delete applications
      allow delete: if isAdmin();
    }
  }
}


